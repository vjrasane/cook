#!/bin/bash
# Source this file to get the menu function.
#
# Usage:
#   menu search <tag> [tag...]
#   menu pick <count> [tag...]
#   menu list
#   menu shop
#   menu clear
#
# Example:
#   source scripts/menu
#   menu pick 2 fish "main course"
#   menu pick 1 vegetarian "main course"
#   menu pick 4
#   menu list
#   menu shop

menu-search() {
  local result
  result=$(cook search "$1" | sed 's/^"//;s/"$//' | sort)
  shift
  for tag in "$@"; do
    result=$(comm -12 <(echo "$result") <(cook search "$tag" | sed 's/^"//;s/"$//' | sort))
  done
  echo "$result"
}

menu-pick() {
  local count=$1
  shift
  local new candidates
  if [ $# -gt 0 ]; then
    candidates=$(menu-search "$@")
  else
    candidates=$(cook search "" | sed 's/^"//;s/"$//' | sort)
  fi
  if [ -n "$_MENU_PICKED" ]; then
    candidates=$(echo "$candidates" | grep -v -F -f <(echo "$_MENU_PICKED"))
  fi
  new=$(echo "$candidates" | shuf | head -n "$count")
  if [ -n "$new" ]; then
    _MENU_PICKED="${_MENU_PICKED:+$_MENU_PICKED
}$new"
  fi
  echo "$new"
}

menu-list() {
  echo "$_MENU_PICKED" | grep -v '^$'
}

menu-shop() {
  local input
  if [ ! -t 0 ]; then
    input=$(cat)
  else
    input=$(menu-list)
  fi
  local recipes=()
  while IFS= read -r line; do
    recipes+=("$line")
  done <<<"$input"
  cook shopping-list "$@" "${recipes[@]}"
}

menu-clear() {
  _MENU_PICKED=""
}

menu() {
  local cmd="$1"
  shift
  case "$cmd" in
  search) menu-search "$@" ;;
  pick) menu-pick "$@" ;;
  list) menu-list ;;
  shop) menu-shop "$@" ;;

  clear) menu-clear ;;
  *)
    echo "usage: menu search|pick|list|shop|clear" >&2
    return 1
    ;;
  esac
}
