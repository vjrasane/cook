{
  "name": "n8n-nodes-listonic",
  "version": "0.1.4",
  "description": "n8n nodes for Listonic shopping list API",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "main": "index.js",
  "scripts": {
    "build": "tsc && for f in src/nodes/*/listonic.svg; do cp \"$f\" \"dist/nodes/$(basename $(dirname \"$f\"))/\"; done",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ListonicCredentials.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ListonicList/ListonicList.node.js",
      "dist/nodes/ListonicItem/ListonicItem.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
